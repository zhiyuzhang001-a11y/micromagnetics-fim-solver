include LICENSE COPYING NOTICE pyproject.toml setup.py
recursive-include LICENSES *
recursive-include fimrun *.py *.json *.html *.js *.three *.typed *.hpp *.h *.cpp *.f64 *.dylib kernel_builder
recursive-include src *.cpp *.hpp *.h
recursive-include validation *
recursive-include tests *.py *.cjs *.mjs *.cpp
recursive-include tools *.py *.sh
recursive-include docs *.md *.json
recursive-include requirements *.txt *.yml *.lock
recursive-include examples *.py *.ipynb *.f64
prune output
prune build-script-api
global-exclude __pycache__ *.pyc .DS_Store
